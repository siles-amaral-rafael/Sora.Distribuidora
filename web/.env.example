# Copia este archivo como .env. Son credenciales locales de desarrollo.
# No subas .env al repositorio ni compartas aquí las credenciales.
POSTGRES_DB=sora
POSTGRES_USER=sora
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_PASSWORD
ConnectionStrings__Postgres=Host=sora-postgres;Port=5432;Database=sora;Username=sora;Password=CHANGE_THIS_LOCAL_PASSWORD;SSL Mode=Disable
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
