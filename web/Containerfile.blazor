FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Sora.Blazor/Sora.Blazor.csproj
RUN dotnet publish src/Sora.Blazor/Sora.Blazor.csproj --configuration Release --no-restore --output /app/publish

FROM docker.io/library/nginx:alpine AS runtime
COPY nginx.blazor.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html
EXPOSE 8080
