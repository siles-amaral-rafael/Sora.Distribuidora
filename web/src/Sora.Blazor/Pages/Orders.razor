@page "/orders"
@inject ApiClient Api
@inject ApiSession Session
@inject NavigationManager Navigation
<PageTitle>Pedidos | Sora</PageTitle>
<header class="page-heading"><div><span class="eyebrow">VENTAS</span><h1>Pedidos</h1><p>El sistema calcula el total y reserva lotes disponibles por vencimiento FEFO.</p></div></header>
<div class="split-layout">
    @if(Session.HasPermission("orders.write")){<section class="panel form-panel"><h2>@(EditingOrder is null ? (ResolvingOrder is null ? "Registrar pedido" : "Confirmar disponibilidad") : $"Editar {EditingOrder.OrderNumber}")</h2>
        @if(ResolvingOrder is null){<EditForm Model="Form" OnValidSubmit="SaveOrder"><DataAnnotationsValidator/>
        <label>Cliente</label><InputSelect class="form-select" disabled="@(EditingOrder is not null)" @bind-Value="CustomerIdText"><option value="">Selecciona cliente</option>@foreach(var c in CustomerRows){<option value="@c.Id">@c.FullName · @c.Phone</option>}</InputSelect>
        <label>Entrega</label><InputSelect class="form-select" @bind-Value="Form.Fulfillment" @bind-Value:after="OnFulfillmentChanged"><option value="DELIVERY">Entrega a domicilio</option><option value="PICKUP_NOW">Retiro inmediato</option><option value="PICKUP_LATER">Retiro posterior</option></InputSelect>
        @if(EditingOrder is null && Form.Fulfillment=="DELIVERY")
        {
            <label class="check-row"><input type="checkbox" @bind="Form.IsNightOrder"/><span><strong>Pedido nocturno</strong> · programar para la primera salida de mañana (@DateTime.Now.Date.AddDays(1).ToString("dd/MM/yyyy"))</span></label>
        }
        <div class="form-grid"><div><label>Producto</label><InputSelect class="form-select" @bind-Value="SelectedProductIdText"><option value="">Selecciona producto</option>@foreach(var p in ProductRows){<option value="@p.Id">@p.Name · Bs @p.UnitSalePrice.ToString("0.00")/u</option>}</InputSelect></div><div><label>Presentación</label><InputSelect class="form-select" @bind-Value="SelectedPresentationId"><option value="">Unidad base</option>@foreach(var p in SelectedProduct?.Presentations.Where(x=>x.IsActive)??[]){<option value="@p.Id">@p.Name (@p.UnitsPerPresentation u)</option>}</InputSelect></div></div>
        <div class="form-grid"><div><label>Cantidad</label><InputNumber class="form-control" min="0.001" step="any" @bind-Value="Quantity"/></div><div class="align-end"><button type="button" class="button secondary" @onclick="AddLine">Añadir producto</button></div></div>
        @if(DraftLines.Count>0){<div class="draft-lines"><h3>Detalle</h3>@foreach(var (line,i) in DraftLines.Select((x,i)=>(x,i))){<div class="draft-row"><span>@line.ProductName · @line.Quantity x @line.UnitName</span>@if(EditingOrder is not null){<InputNumber class="form-control" min="0.001" step="any" @bind-Value="line.Quantity"/>}<strong>Bs @line.Total.ToString("0.00")</strong><button type="button" class="icon-button" @onclick="()=>DraftLines.RemoveAt(i)">×</button></div>}<div class="total-row"><span>Subtotal estimado (beneficio final según costo FEFO)</span><strong>Bs @DraftLines.Sum(x=>x.Total).ToString("0.00")</strong></div></div>}
        <button class="button primary full" disabled="@(DraftLines.Count==0)">@(EditingOrder is null ? "Confirmar y reservar" : "Guardar cambios y reservar")</button>
        @if(EditingOrder is not null){<button type="button" class="button secondary full" @onclick="ClearEdit">Salir de edición</button>}</EditForm>}
        else{<p class="muted">Ajusta las cantidades antes de confirmar. Los faltantes se muestran en cada línea.</p>
            @foreach(var (line,i) in DraftLines.Select((x,i)=>(x,i))){<div class="draft-row"><span>@line.ProductName · @line.UnitName<br/><small>Solicitado: @line.OriginalRequestedUnits unidades; disponibles al registrar: @line.AvailableUnits; faltan: @line.ShortageUnits</small></span><InputNumber class="form-control" min="0" step="1" @bind-Value="line.QuantityUnits"/><button type="button" class="icon-button" @onclick="()=>DraftLines.RemoveAt(i)">×</button></div>}
            <label>Nota de confirmación (acuerdo con el cliente)</label><InputText class="form-control" @bind-Value="ConfirmationNote" />
            <div class="actions"><button class="button primary" @onclick="()=>ConfirmShortage(true)">Aceptar cantidades y reservar</button><button class="button secondary" @onclick="()=>ConfirmShortage(false)">Rechazar pedido</button><button class="button secondary" @onclick="ClearEdit">Cerrar</button></div>}
        @if(Error is not null){<div class="alert error">@Error</div>}@if(Notice is not null){<div class="alert success">@Notice</div>}
    </section>}
    <section class="panel"><div class="panel-title"><div><h2>Pedidos recientes</h2><p class="muted">Hasta 200 registros más recientes.</p></div><button class="button secondary" @onclick="Load">Actualizar</button></div>
        <div class="table-scroll"><table><thead><tr><th>Número</th><th>Cliente</th><th>Estado</th><th>Tipo / programación</th><th>Total / pagado / saldo</th><th>Lotes FEFO / faltantes</th><th>Acción</th></tr></thead><tbody>@foreach(var o in OrderRows){<tr><td><strong>@o.OrderNumber</strong></td><td>@CustomerRows.FirstOrDefault(c=>c.Id==o.CustomerId)?.FullName</td><td><span class="status-pill">@StatusName(o.Status)</span></td><td>@FulfillmentName(o.Fulfillment)@if(o.IsNightOrder){<br/><small>Turno nocturno · primera salida @o.ScheduledDeliveryDate?.ToString("dd/MM/yyyy")</small>}</td><td>Bs @o.TotalAmount.ToString("0.00")<br/><small>Pagado @o.PaidAmount.ToString("0.00") · Saldo @o.BalanceDue.ToString("0.00")</small></td><td>@if(o.Status=="PENDING_CONFIRMATION"){@foreach(var l in o.Lines.Where(x=>x.ShortageUnits>0)){<span>@l.ProductName: @l.UnitsAvailableAtCreation disponible, faltan @l.ShortageUnits<br/></span>}}else{@string.Join(", ",o.Lines.SelectMany(l=>l.Lots).Select(l=>l.LotCode).Distinct())}</td><td>
            @if(o.Status=="PENDING_CONFIRMATION" && Session.HasPermission("orders.write")){<button class="link-button" @onclick="()=>BeginResolution(o)">Revisar faltante</button>}
            @if((o.Status is "REGISTERED" or "PREPARED") && Session.HasPermission("orders.write")){<button class="link-button" @onclick="()=>BeginEdit(o)">Editar</button>}
            @if(o.Fulfillment=="DELIVERY" && o.Status=="REGISTERED" && Session.HasPermission("orders.prepare")){<button class="link-button" @onclick="()=>MarkPrepared(o)">Marcar preparado</button>}
            @if(o.CanPickup && (o.Status is "REGISTERED" or "PREPARED") && Session.HasPermission("orders.pickup")){<button class="link-button" @onclick="()=>CompletePickup(o)">Confirmar retiro</button>}
            @if((o.Status is "REGISTERED" or "PREPARED") && Session.HasPermission("orders.cancel")){<button class="link-button danger-link" @onclick="()=>CancelOrder(o)">Cancelar y liberar reserva</button>}
        </td></tr><tr><td colspan="7"><details><summary>Detalle, pagos e historial (@o.History.Count eventos)</summary>@foreach(var l in o.Lines){<div class="muted">@l.ProductName · @l.Quantity x @(l.Presentation??"unidad") · Subtotal Bs @l.SubtotalAmount.ToString("0.00") · Beneficio Bs @l.DiscountAmount.ToString("0.00") · Total Bs @l.LineTotal.ToString("0.00")</div>}
            @foreach(var pay in o.Payments){<div class="muted">@((pay.Kind=="CREDIT")?"Crédito aplicado":"Pago de caja") Bs @pay.Amount.ToString("0.00") · referencia @pay.Reference · @pay.RecordedAtUtc.ToLocalTime().ToString("g") · @pay.RecordedBy</div>}
            @if((o.Status is "REGISTERED" or "PREPARED") && Session.HasPermission("orders.cancel") && o.PaidAmount>0){
                <div class="form-grid"><div><label>Al cancelar: devolución o crédito</label><select class="form-select" @bind="CancelResolutions[o.Id]"><option value="REFUND">Devolver (registrar referencia)</option><option value="CREDIT">Dejar como crédito para otra compra</option></select></div><div><label>Referencia de devolución / autorización</label><input class="form-control" @bind="CancelReferences[o.Id]"/></div></div>
            }
            @if(o.BalanceDue>0 && Session.HasPermission("payments.record") && o.Status!="CANCELLED"){
                <div class="form-grid"><div><label>Abono / monto cobrado (Bs)</label><input class="form-control" type="number" min="0.01" step="0.01" @bind="PaymentAmounts[o.Id]"/></div><div><label>Referencia del comprobante de caja</label><input class="form-control" @bind="PaymentReferences[o.Id]"/></div></div>
                <button class="button secondary" @onclick="()=>RecordPayment(o)">Registrar pago simulado</button><small class="muted">La prueba no se conecta al sistema de caja. Cliente particular: permite abono; tienda o institución: pago total.</small>
            }
            @foreach(var h in o.History){<div class="muted">@h.OccurredAtUtc.ToLocalTime().ToString("g") · @h.ActorName · @h.EventType · @h.Details</div>}</details></td></tr>}</tbody></table></div>
        @if(OrderRows.Count==0){<p class="empty">Los pedidos creados aparecerán aquí.</p>}
    </section>
</div>
@code {
    private List<CustomerResponse> CustomerRows=[];private List<ProductResponse> ProductRows=[];private List<OrderResponse> OrderRows=[]; private Dictionary<Guid,decimal> PaymentAmounts=[]; private Dictionary<Guid,string> PaymentReferences=[]; private Dictionary<Guid,string> CancelResolutions=[]; private Dictionary<Guid,string> CancelReferences=[];
    private CreateOrderRequest Form {get;set;}=new(){Fulfillment="DELIVERY"};private string CustomerIdText="",SelectedProductIdText="";private Guid? SelectedPresentationId;private decimal Quantity=1;private List<DraftLine> DraftLines=[];private string? Error,Notice; private OrderResponse? EditingOrder,ResolvingOrder; private string ConfirmationNote="";
    private ProductResponse? SelectedProduct=>Guid.TryParse(SelectedProductIdText,out var id)?ProductRows.FirstOrDefault(x=>x.Id==id):null;
    private void OnFulfillmentChanged(){if(Form.Fulfillment!="DELIVERY")Form.IsNightOrder=false;}
    protected override async Task OnInitializedAsync(){if(!Session.IsSignedIn){Navigation.NavigateTo("/login");return;}if(!Session.CanAccessPage("orders")){Navigation.NavigateTo("/forbidden");return;}var c=await Api.SendAsync<List<CustomerResponse>>(HttpMethod.Get,"api/customers");if(c.IsSuccess)CustomerRows=c.Value??[];var p=await Api.SendAsync<List<ProductResponse>>(HttpMethod.Get,"api/products");if(p.IsSuccess)ProductRows=p.Value??[];await Load();}
    private async Task Load(){var r=await Api.SendAsync<List<OrderResponse>>(HttpMethod.Get,"api/orders");if(r.IsSuccess){OrderRows=r.Value??[];foreach(var o in OrderRows){PaymentAmounts[o.Id]=o.BalanceDue;PaymentReferences.TryAdd(o.Id,"");CancelResolutions.TryAdd(o.Id,"REFUND");CancelReferences.TryAdd(o.Id,"");}}else Error=r.Error;}
    private async Task RecordPayment(OrderResponse order){if(PaymentAmounts.GetValueOrDefault(order.Id)<=0||string.IsNullOrWhiteSpace(PaymentReferences.GetValueOrDefault(order.Id))){Error="Ingresa el monto cobrado y la referencia del comprobante de caja.";return;}var req=new RecordPaymentRequest{Amount=PaymentAmounts[order.Id],Reference=PaymentReferences[order.Id]};var r=await Api.SendAsync<OrderResponse>(HttpMethod.Post,$"api/orders/{order.Id}/payments",req);if(!r.IsSuccess){Error=PaymentError(r.Error);return;}Notice=$"Pago de Bs {req.Amount:0.00} registrado para {order.OrderNumber}.";Error=null;PaymentReferences[order.Id]="";await Load();}
    private async Task MarkPrepared(OrderResponse order){var r=await Api.SendAsync<object>(HttpMethod.Put,$"api/orders/{order.Id}/prepare");if(!r.IsSuccess){Error=PaymentError(r.Error);return;}Notice=$"Pedido {order.OrderNumber} marcado como preparado.";Error=null;await Load();}
    private async Task CompletePickup(OrderResponse order){var r=await Api.SendAsync<object>(HttpMethod.Put,$"api/orders/{order.Id}/pickup");if(!r.IsSuccess){Error=r.Error;Notice=null;return;}Notice=$"Retiro del pedido {order.OrderNumber} confirmado; unidades descontadas del stock físico.";Error=null;await Load();}
    private async Task CancelOrder(OrderResponse order){var resolution=order.PaidAmount>0?CancelResolutions.GetValueOrDefault(order.Id,"REFUND"):"NONE";var reference=CancelReferences.GetValueOrDefault(order.Id,"");if(resolution is "REFUND" or "CREDIT"&&string.IsNullOrWhiteSpace(reference)){Error="Ingresa la referencia de devolución o autorización del crédito.";return;}var r=await Api.SendAsync<object>(HttpMethod.Put,$"api/orders/{order.Id}/cancel",new CancelOrderRequest{Resolution=resolution,Reference=reference});if(!r.IsSuccess){Error=PaymentError(r.Error);Notice=null;return;}Notice=resolution=="CREDIT"?$"Pedido cancelado; Bs {order.PaidAmount:0.00} quedó como crédito del cliente.":$"Pedido {order.OrderNumber} cancelado y reserva liberada.";Error=null;await Load();}
    private void AddLine(){if(!Guid.TryParse(SelectedProductIdText,out var productId)){Error="Selecciona un producto.";return;}var product=ProductRows.FirstOrDefault(x=>x.Id==productId);if(product is null||Quantity<=0){Error="Selecciona producto y cantidad.";return;}var presentation=product.Presentations.FirstOrDefault(x=>x.Id==SelectedPresentationId);var units=presentation?.UnitsPerPresentation??1;var count=Quantity*units;if(count!=decimal.Truncate(count)){Error="La cantidad debe equivaler a un número entero de unidades.";return;}DraftLines.Add(new(product.Id,SelectedPresentationId,Quantity,product.Name,presentation?.Name??product.BaseUnit,product.UnitSalePrice,unitsPerPresentation:units));Error=null;}
    private async Task SaveOrder(){if(DraftLines.Count==0){Error="Agrega al menos un producto.";return;}if(DraftLines.Any(x=>x.Quantity<=0||x.Quantity*x.UnitsPerPresentation!=decimal.Truncate(x.Quantity*x.UnitsPerPresentation))){Error="Revisa las cantidades: deben equivaler a unidades enteras.";return;}var lines=DraftLines.Select(x=>new CreateOrderLineRequest{ProductId=x.ProductId,PresentationId=x.PresentationId,Quantity=x.Quantity}).ToList();
        if(EditingOrder is not null){var req=new UpdateOrderRequest{Fulfillment=Form.Fulfillment,Lines=lines};var updated=await Api.SendAsync<OrderResponse>(HttpMethod.Put,$"api/orders/{EditingOrder.Id}",req);if(!updated.IsSuccess){Error=ErrorMessage(updated.Error);return;}Notice=$"Pedido {updated.Value?.OrderNumber} actualizado y reservado.";}
        else{if(!Guid.TryParse(CustomerIdText,out var customer)){Error="Selecciona un cliente existente.";return;}var req=new CreateOrderRequest{CustomerId=customer,Fulfillment=Form.Fulfillment,IsNightOrder=Form.IsNightOrder,Lines=lines};var created=await Api.SendAsync<OrderResponse>(HttpMethod.Post,"api/orders",req);if(!created.IsSuccess){Error=ErrorMessage(created.Error);return;}Notice=created.Value?.Status=="PENDING_CONFIRMATION"?$"Pedido {created.Value.OrderNumber} guardado pendiente de confirmar disponibilidad.":$"Pedido {created.Value?.OrderNumber} guardado. Total: Bs {created.Value?.TotalAmount:0.00}.";if(created.Value?.IsNightOrder==true)Notice+=$" Programado para primera salida del {created.Value.ScheduledDeliveryDate:dd/MM/yyyy}.";}
        Error=null;ClearEdit();await Load();}
    private void BeginEdit(OrderResponse o){EditingOrder=o;ResolvingOrder=null;Form=new(){Fulfillment=o.Fulfillment};CustomerIdText=o.CustomerId.ToString();DraftLines=o.Lines.Select(x=>{var product=ProductRows.FirstOrDefault(p=>p.Id==x.ProductId);var presentation=product?.Presentations.FirstOrDefault(p=>p.Name==x.Presentation);return new DraftLine(x.ProductId,presentation?.Id,x.Quantity,x.ProductName,x.Presentation??product?.BaseUnit??"unidad",x.UnitPrice,x.UnitsAvailableAtCreation,x.ShortageUnits,unitsPerPresentation:presentation?.UnitsPerPresentation??1);}).ToList();Error=null;}
    private void BeginResolution(OrderResponse o){ResolvingOrder=o;EditingOrder=null;ConfirmationNote="Cliente contactado para confirmar disponibilidad.";DraftLines=o.Lines.Select(x=>new DraftLine(x.ProductId,null,x.UnitsAvailableAtCreation,x.ProductName,ProductRows.FirstOrDefault(p=>p.Id==x.ProductId)?.BaseUnit??"unidad",x.UnitPrice,x.UnitsAvailableAtCreation,x.ShortageUnits,originalRequestedUnits:x.QuantityUnits)).ToList();Error=null;}
    private async Task ConfirmShortage(bool accepted){if(ResolvingOrder is null)return;if(string.IsNullOrWhiteSpace(ConfirmationNote)){Error="Registra la nota del acuerdo con el cliente.";return;}var req=new ConfirmOrderAvailabilityRequest{Accepted=accepted,ConfirmationNote=ConfirmationNote,Lines=accepted?DraftLines.Where(x=>x.QuantityUnits>0).Select(x=>new CreateOrderLineRequest{ProductId=x.ProductId,PresentationId=null,Quantity=x.QuantityUnits}).ToList():[]};var r=await Api.SendAsync<OrderResponse>(HttpMethod.Put,$"api/orders/{ResolvingOrder.Id}/availability",req);if(!r.IsSuccess){Error=r.Error;return;}Notice=accepted?$"Pedido {r.Value?.OrderNumber} confirmado y reservado.":$"Pedido {r.Value?.OrderNumber} rechazado y cancelado.";Error=null;ClearEdit();await Load();}
    private void ClearEdit(){EditingOrder=null;ResolvingOrder=null;DraftLines.Clear();ConfirmationNote="";Form=new(){Fulfillment="DELIVERY"};}
    private static string ErrorMessage(string? error)=>error switch{"sale_below_lot_cost"=>"No se puede confirmar: el precio de venta queda por debajo del costo de los lotes FEFO.","insufficient_stock"=>"La disponibilidad cambió. Ajusta el pedido según el stock actual.","customer_outstanding_balance"=>"El cliente tiene un saldo pendiente; no se puede registrar otro pedido.","order_transition_not_allowed"=>"El pedido ya no se puede editar en su estado actual.",_=>error??"No se pudo guardar el pedido."};
    private static string PaymentError(string? error)=>error switch{"customer_type_requires_full_payment"=>"Las tiendas e instituciones deben pagar el total en una sola operación.","payment_exceeds_balance"=>"El monto supera el saldo pendiente.","payment_reference_already_used"=>"Esa referencia de caja ya está asociada a otro pago.","payment_required_for_fulfillment"=>"Registra primero el pago requerido; el pedido no puede prepararse todavía.","payment_resolution_required"=>"Selecciona devolución o crédito y registra su referencia.","cancellation_reference_required"=>"La devolución o el crédito requieren una referencia o autorización.","payment_not_allowed"=>"El pedido todavía no admite pagos.",_=>error??"No se pudo registrar el pago."};
    private static string StatusName(string s)=>s switch{"PENDING_CONFIRMATION"=>"Pendiente de confirmación","REGISTERED"=>"Registrado","PREPARED"=>"Preparado","DISPATCHED"=>"En reparto","DELIVERED"=>"Entregado","DELIVERY_FAILED"=>"Entrega fallida","CANCELLED"=>"Cancelado",_=>s};
    private static string FulfillmentName(string s)=>s switch{"DELIVERY"=>"Domicilio","PICKUP_NOW"=>"Retiro hoy",_=>"Retiro posterior"};
    private sealed class DraftLine(Guid productId,Guid? presentationId,decimal quantity,string productName,string unitName,decimal unitPrice,int available=0,int shortage=0,int unitsPerPresentation=1,int originalRequestedUnits=0){public Guid ProductId{get;}=productId;public Guid? PresentationId{get;}=presentationId;public decimal Quantity{get;set;}=quantity;public string ProductName{get;}=productName;public string UnitName{get;}=unitName;public int QuantityUnits{get=>decimal.ToInt32(Quantity*UnitsPerPresentation);set=>Quantity=(decimal)value/UnitsPerPresentation;}public decimal UnitPrice{get;}=unitPrice;public int AvailableUnits{get;}=available;public int ShortageUnits{get;}=shortage;public int OriginalRequestedUnits{get;}=originalRequestedUnits;public int UnitsPerPresentation{get;}=unitsPerPresentation;public decimal Total=>QuantityUnits*UnitPrice;}
}
