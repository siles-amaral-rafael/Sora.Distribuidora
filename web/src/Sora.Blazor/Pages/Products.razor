@page "/products"
@inject ApiClient Api
@inject ApiSession Session
@inject NavigationManager Navigation

<PageTitle>Productos | Sora</PageTitle>
<div class="products-page">
<header class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>Productos</h1><p>Registra varios productos en una sola operación y administra sus presentaciones.</p></div>@if(Session.HasPermission("products.write")){<button class="button primary" @onclick="OpenBatch">+ Agregar productos</button>}</header>
<FormModal IsOpen="BatchFormOpen" Title="Agregar productos" OnClose="CloseBatch">
    <p class="muted">Añade una fila por producto. El sistema asigna el código Sora automáticamente.</p>
    <datalist id="product-categories">@foreach(var category in ExistingCategories){<option value="@category"/>}</datalist>
    @foreach(var (row,index) in Rows.Select((x,i)=>(x,i)))
    {
        <article class="product-entry-row">
            <div class="product-row-header"><strong>Producto @(index+1)</strong>@if(Rows.Count>1){<button type="button" class="button danger-outline small" @onclick="()=>Rows.RemoveAt(index)">Quitar fila</button>}</div>
            <label>Nombre del producto</label><InputText class="form-control" @bind-Value="row.Name" placeholder="Ej.: Arroz" />
            <div class="form-grid"><div><label>Marca</label><InputText class="form-control" @bind-Value="row.Brand" placeholder="Opcional" /></div><div><label>Categoría</label><InputText class="form-control" list="product-categories" @bind-Value="row.Category" placeholder="Elige o escribe" /></div></div>
            <div class="form-grid three"><div><label>Contenido neto</label><InputNumber class="form-control" min="0.001" step="0.001" @bind-Value="row.NetContent" /></div><div><label>Unidad</label><InputSelect class="form-select" @bind-Value="row.ContentUnit"><option value="">—</option>@foreach(var unit in ContentUnits){<option value="@unit">@unit</option>}</InputSelect></div><div><label>Precio unitario (Bs)</label><InputNumber class="form-control" min="0" step="0.01" @bind-Value="row.UnitSalePrice" /></div></div>
            <div class="form-grid"><div><label>Unidad base</label><InputSelect class="form-select" @bind-Value="row.BaseUnit">@foreach(var unit in BaseUnits){<option value="@unit">@unit</option>}</InputSelect></div><div><label>Código externo / barras (opcional)</label><InputText class="form-control" @bind-Value="row.Barcode" placeholder="Si ya viene impreso en el producto" /></div></div>
            <small class="muted">Código Sora: se generará al guardar y será numérico y único.</small>
        </article>
    }
    @if(Error is not null){<div class="alert error">@Error</div>}
    <div class="actions product-batch-actions"><button type="button" class="button secondary" @onclick="AddRow" disabled="@(Rows.Count>=50)">+ Añadir otra fila</button><button type="button" class="button primary" @onclick="SaveBatch" disabled="@(!Rows.Any())">Guardar @Rows.Count producto@(Rows.Count==1?"":"s")</button></div>
</FormModal>
<div class="split-layout product-layout">
    @if(Session.HasPermission("products.write") && EditingId is not null)
    {
        <section class="panel form-panel">

                <h2>Editar producto</h2>
                <div class="generated-code"><span>Código Sora</span><strong>@EditForm.InternalCode</strong><small>El código generado se conserva para no alterar referencias anteriores.</small></div>
                <EditForm Model="EditForm" OnValidSubmit="SaveEdit"><DataAnnotationsValidator />
                    <label>Nombre</label><InputText class="form-control" @bind-Value="EditForm.Name" />
                    <div class="form-grid"><div><label>Marca</label><InputText class="form-control" @bind-Value="EditForm.Brand" /></div><div><label>Categoría</label><InputText class="form-control" list="product-categories" @bind-Value="EditForm.Category" /></div></div>
                    <div class="form-grid three"><div><label>Contenido neto</label><InputNumber class="form-control" min="0.001" step="0.001" @bind-Value="EditForm.NetContent" /></div><div><label>Unidad</label><InputText class="form-control" @bind-Value="EditForm.ContentUnit" /></div><div><label>Precio unitario (Bs)</label><InputNumber class="form-control" min="0" step="0.01" @bind-Value="EditForm.UnitSalePrice" /></div></div>
                    <div class="form-grid"><div><label>Unidad base</label><InputSelect class="form-select" @bind-Value="EditForm.BaseUnit">@foreach(var unit in BaseUnits){<option value="@unit">@unit</option>}</InputSelect></div><div><label>Código externo / barras</label><InputText class="form-control" @bind-Value="EditForm.Barcode" /></div></div>
                    <div class="actions"><button class="button primary">Guardar cambios</button><button type="button" class="button secondary" @onclick="ResetEdit">Volver</button></div>
                </EditForm>
            @if(Error is not null){<div class="alert error">@Error</div>} @if(Notice is not null){<div class="alert success">@Notice</div>}
        </section>
    }
    <section class="panel product-catalog-panel">
        <div class="panel-title"><div><h2>Catálogo de productos</h2><p class="muted">@ProductRows.Count activos · @ProductRows.Count(x=>!x.IsActive) inactivos</p></div><button class="button secondary" @onclick="Load">Actualizar</button></div>
        <CollectionBrowser TItem="ProductResponse" Items="ProductRows" Columns="ProductColumns" Context="pageProducts">
        @foreach (var product in pageProducts)
        {
            <article class="product-row"><div class="product-row-main">
                <span class="code">CÓDIGO SORA · @product.InternalCode @if(!product.IsActive){<span class="status-pill">Inactivo</span>}</span>
                @if(!string.IsNullOrWhiteSpace(product.Barcode)){<small class="muted">Código de barras · @product.Barcode</small>}
                <strong>@product.Name</strong><small>@(product.Brand ?? "Sin marca") · @(product.Category ?? "Sin categoría") @if(product.NetContent is not null){<span>· @product.NetContent @product.ContentUnit</span>}</small><span>Bs @product.UnitSalePrice.ToString("0.00") / @product.BaseUnit</span>
                @if (product.Presentations.Count > 0) { <div class="chips">@foreach(var presentation in product.Presentations.Where(x=>x.IsActive)) { <span>@presentation.Name · @presentation.UnitsPerPresentation u.</span> }</div> }
                @if(Session.HasPermission("products.write"))
                {
                    @if(PresentingProduct==product.Id){<div class="presentation-editor"><input class="form-control" placeholder="Nombre (caja, paquete)" @bind="PresentationName"/><input class="form-control" type="number" min="1" placeholder="Unidades" @bind="PresentationUnits"/><button class="button primary" @onclick="()=>AddPresentation(product.Id)">Añadir presentación</button></div>}
                    <div class="row-actions"><button class="button secondary small" @onclick="()=>Edit(product)">Editar</button><button class="button secondary small" @onclick="()=>TogglePresentation(product.Id)">+ Presentación</button>@if(product.IsActive){<button class="button danger-outline small" @onclick="()=>Deactivate(product)">Desactivar</button>}else{<button class="button secondary small" @onclick="()=>Activate(product)">Reactivar</button>}</div>
                }
                @if (Session.HasPermission("discounts.manage"))
                {
                    <div class="row-actions"><button class="link-button" @onclick="()=>BeginDiscountEdit(product)">Configurar beneficios</button></div>
                    @if (DiscountRulesProductId==product.Id)
                    {
                        <div class="presentation-editor discount-editor"><strong>Tramos de beneficio · @product.Name</strong><p class="muted">El descuento se limita para conservar al menos el 80% del margen bruto de los lotes utilizados.</p>
                            @foreach(var (rule,index) in DiscountRuleDrafts.Select((x,i)=>(x,i))){<div class="form-grid"><div><label>Desde unidades</label><InputNumber class="form-control" min="1" @bind-Value="rule.MinimumQuantityUnits"/></div><div><label>Beneficio solicitado (%)</label><InputNumber class="form-control" min="0.01" max="100" step="0.01" @bind-Value="rule.DiscountPercent"/></div><button type="button" class="button danger-outline small" @onclick="()=>DiscountRuleDrafts.RemoveAt(index)">Quitar</button></div>}
                            <div class="form-grid"><div><label>Nuevo tramo: desde unidades</label><InputNumber class="form-control" min="1" @bind-Value="NewRuleMinimum"/></div><div><label>Beneficio solicitado (%)</label><InputNumber class="form-control" min="0.01" max="100" step="0.01" @bind-Value="NewRulePercent"/></div><button type="button" class="button secondary" @onclick="AddDiscountRule">Añadir tramo</button></div><button class="button primary" @onclick="SaveDiscountRules">Guardar tramos</button>
                        </div>
                    }
                }
            </div></article>
        }
        </CollectionBrowser>
        @if(ProductRows.Count==0){<p class="empty">Todavía no hay productos registrados.</p>}
    </section>
</div>
</div>

@code {
    private static readonly CollectionColumn<ProductResponse>[] ProductColumns =
    [
        new("code", "Código Sora", x => x.InternalCode, x => x.InternalCode),
        new("barcode", "Código de barras", x => x.Barcode, x => x.Barcode),
        new("name", "Producto", x => x.Name, x => x.Name),
        new("brand", "Marca", x => x.Brand, x => x.Brand),
        new("category", "Categoría", x => x.Category, x => x.Category),
        new("price", "Precio por unidad", x => x.UnitSalePrice.ToString("0.00"), x => x.UnitSalePrice),
        new("status", "Estado", x => x.IsActive ? "Activo" : "Inactivo", x => x.IsActive ? "Activo" : "Inactivo")
    ];
    private static readonly string[] BaseUnits=["unidad","bolsa","botella","paquete","lata","caja","kg"];
    private static readonly string[] ContentUnits=["g","kg","ml","l","unidades"];
    private List<ProductResponse> ProductRows=[];
    private List<ProductEntryRow> Rows=[new()];
    private SaveProductRequest EditForm {get;set;}=NewEditForm();
    private Guid? EditingId,PresentingProduct,DiscountRulesProductId;
    private bool BatchFormOpen;
    private string PresentationName="Caja"; private int PresentationUnits=1;
    private string? Error,Notice; private List<DiscountRuleDraft> DiscountRuleDrafts=[];
    private int NewRuleMinimum=12; private decimal NewRulePercent=1;
    private IEnumerable<string> ExistingCategories => ProductRows.Select(x=>x.Category).OfType<string>().Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x);

    protected override async Task OnInitializedAsync(){if(!Session.IsSignedIn){Navigation.NavigateTo("/login");return;}if(!Session.CanAccessPage("products")){Navigation.NavigateTo("/forbidden");return;}await Load();}
    private async Task Load(){var r=await Api.SendAsync<List<ProductResponse>>(HttpMethod.Get,"api/products");if(r.IsSuccess)ProductRows=r.Value??[];else Error=r.Error;}
    private void OpenBatch(){Rows=[new()];Error=null;BatchFormOpen=true;}
    private void CloseBatch(){BatchFormOpen=false;Error=null;}
    private void AddRow(){if(Rows.Count<50)Rows.Add(new());}
    private async Task SaveBatch(){
        if(Rows.Count==0||Rows.Any(x=>string.IsNullOrWhiteSpace(x.Name)||x.UnitSalePrice<0||x.NetContent is <=0)){Error="Completa el nombre, contenido válido y precio de cada fila antes de guardar.";return;}
        var request=new CreateProductsRequest{Products=Rows.Select(x=>new SaveProductRequest{Barcode=x.Barcode,Name=x.Name,Brand=x.Brand,Category=x.Category,NetContent=x.NetContent,ContentUnit=x.ContentUnit,BaseUnit=x.BaseUnit,UnitSalePrice=x.UnitSalePrice}).ToList()};
        var result=await Api.SendAsync<List<ProductResponse>>(HttpMethod.Post,"api/products/bulk",request);
        if(!result.IsSuccess){Error=ProductError(result.Error);Notice=null;return;}
        Notice=$"Se guardaron {result.Value?.Count??Rows.Count} productos. Los códigos Sora fueron generados automáticamente.";Error=null;Rows=[new()];BatchFormOpen=false;await Load();
    }
    private void Edit(ProductResponse p){EditingId=p.Id;EditForm=new(){InternalCode=p.InternalCode,Barcode=p.Barcode,Name=p.Name,Brand=p.Brand,Category=p.Category,NetContent=p.NetContent,ContentUnit=p.ContentUnit,BaseUnit=p.BaseUnit,UnitSalePrice=p.UnitSalePrice};Error=null;Notice=null;}
    private async Task SaveEdit(){if(EditingId is not Guid id)return;var result=await Api.SendAsync<ProductResponse>(HttpMethod.Put,$"api/products/{id}",EditForm);if(!result.IsSuccess){Error=ProductError(result.Error);return;}Notice="Producto actualizado.";Error=null;EditingId=null;EditForm=NewEditForm();await Load();}
    private async Task Deactivate(ProductResponse p){var r=await Api.SendAsync<object>(HttpMethod.Delete,$"api/products/{p.Id}");if(r.IsSuccess){Notice="Producto desactivado.";await Load();}else Error=r.Error;}
    private async Task Activate(ProductResponse p){var r=await Api.SendAsync<object>(HttpMethod.Post,$"api/products/{p.Id}/activate");if(r.IsSuccess){Notice="Producto reactivado.";await Load();}else Error=r.Error;}
    private async Task AddPresentation(Guid id){var r=await Api.SendAsync<ProductPresentationResponse>(HttpMethod.Post,$"api/products/{id}/presentations",new SaveProductPresentationRequest{Name=PresentationName,UnitsPerPresentation=PresentationUnits});if(r.IsSuccess){Notice="Presentación agregada.";PresentingProduct=null;await Load();}else Error=r.Error;}
    private void TogglePresentation(Guid id)=>PresentingProduct=PresentingProduct==id?null:id;
    private void ResetEdit(){EditingId=null;EditForm=NewEditForm();Error=null;}
    private void BeginDiscountEdit(ProductResponse product){DiscountRulesProductId=product.Id;DiscountRuleDrafts=product.DiscountRules.Select(x=>new DiscountRuleDraft{MinimumQuantityUnits=x.MinimumQuantityUnits,DiscountPercent=x.DiscountPercent}).ToList();}
    private void AddDiscountRule(){if(NewRuleMinimum<=0||NewRulePercent<=0||NewRulePercent>100||DiscountRuleDrafts.Any(x=>x.MinimumQuantityUnits==NewRuleMinimum)){Error="Cada tramo debe tener unidades únicas y un porcentaje entre 0 y 100.";return;}DiscountRuleDrafts.Add(new(){MinimumQuantityUnits=NewRuleMinimum,DiscountPercent=NewRulePercent});DiscountRuleDrafts=DiscountRuleDrafts.OrderBy(x=>x.MinimumQuantityUnits).ToList();Error=null;}
    private async Task SaveDiscountRules(){if(DiscountRulesProductId is not Guid id)return;if(DiscountRuleDrafts.Any(x=>x.MinimumQuantityUnits<=0||x.DiscountPercent<=0||x.DiscountPercent>100)||DiscountRuleDrafts.Select(x=>x.MinimumQuantityUnits).Distinct().Count()!=DiscountRuleDrafts.Count){Error="Revisa unidades mínimas y porcentajes; no se permiten tramos duplicados.";return;}var req=new ReplaceProductDiscountRulesRequest{Rules=DiscountRuleDrafts.Select(x=>new SaveProductDiscountRuleRequest{MinimumQuantityUnits=x.MinimumQuantityUnits,DiscountPercent=x.DiscountPercent}).ToList()};var r=await Api.SendAsync<ProductResponse>(HttpMethod.Put,$"api/products/{id}/discount-rules",req);if(!r.IsSuccess){Error=r.Error;Notice=null;return;}Notice="Tramos de beneficio guardados.";Error=null;DiscountRulesProductId=null;await Load();}
    private static string ProductError(string? code)=>code switch{"product_barcode_already_exists"=>"Ese código de barras ya está asignado a otro producto.","product_code_generation_failed"=>"No se pudo generar un código único. Intenta guardar de nuevo.",_=>code??"No se pudieron guardar los productos."};
    private static SaveProductRequest NewEditForm()=>new(){BaseUnit="unidad"};
    private sealed class ProductEntryRow{public string Name{get;set;}="";public string? Brand{get;set;}public string? Category{get;set;}public decimal? NetContent{get;set;}public string? ContentUnit{get;set;}="g";public string BaseUnit{get;set;}="unidad";public decimal UnitSalePrice{get;set;}public string? Barcode{get;set;}}
    private sealed class DiscountRuleDraft{public int MinimumQuantityUnits{get;set;}=1;public decimal DiscountPercent{get;set;}=1;}
}
