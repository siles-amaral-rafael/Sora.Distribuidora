@page "/notifications"
@inject ApiClient Api
@inject ApiSession Session
@inject NavigationManager Navigation
<PageTitle>Avisos | Sora</PageTitle>
<header class="page-heading"><div><span class="eyebrow">COMUNICACIONES</span><h1>Avisos de estado</h1><p>Cola interna persistente: cuando el sistema vuelve a estar disponible, los avisos pendientes se conservan y se pueden procesar o reintentar. El estado enviado aquí es una simulación local y no contacta WhatsApp ni Telegram.</p></div></header>
<section class="panel"><div class="panel-title"><div><h2>Cola de avisos</h2><p class="muted">El teléfono proviene de la ficha registrada del cliente.</p></div><button class="button secondary" @onclick="Load">Actualizar</button></div>
    @if(Error is not null){<div class="alert error">@Error</div>}
    <div class="table-scroll"><table><thead><tr><th>Creado</th><th>Pedido / cliente</th><th>Evento</th><th>Destinatario</th><th>Mensaje de prueba</th><th>Estado</th><th></th></tr></thead><tbody>
    @foreach(var n in Rows){<tr><td>@n.CreatedAtUtc.ToLocalTime().ToString("g")</td><td><strong>@n.OrderNumber</strong><br/>@n.CustomerName</td><td>@EventName(n.EventType)</td><td>@n.RecipientPhone</td><td>@n.Message</td><td><span class="status-pill">@StateName(n.State)</span><br/><small>Local · intentos @n.Attempts · reintentos @n.RetryCount</small>@if(n.LastError is not null){<br/><small>@n.LastError</small>}</td><td>@if(n.State=="PENDING"){<button class="link-button" @onclick="()=>Simulate(n)">Procesar internamente</button><button class="link-button danger-link" @onclick="()=>SimulateFailure(n)">Simular fallo</button>}else if(n.State=="FAILED"){<button class="link-button" @onclick="()=>Retry(n)">Reintentar</button>}</td></tr>}
    </tbody></table></div>
    @if(Rows.Count==0){<p class="empty">Los avisos generados por los pedidos aparecerán aquí.</p>}
</section>
@code {
    private List<NotificationOutboxResponse> Rows=[]; private string? Error;
    protected override async Task OnInitializedAsync(){if(!Session.IsSignedIn){Navigation.NavigateTo("/login");return;}if(!Session.CanAccessPage("notifications")){Navigation.NavigateTo("/forbidden");return;}await Load();}
    private async Task Load(){var r=await Api.SendAsync<List<NotificationOutboxResponse>>(HttpMethod.Get,"api/notifications/outbox");if(r.IsSuccess){Rows=r.Value??[];Error=null;}else Error=r.Error;}
    private async Task Simulate(NotificationOutboxResponse n){var r=await Api.SendAsync<object>(HttpMethod.Post,$"api/notifications/outbox/{n.Id}/simulate-send");if(!r.IsSuccess){Error=r.Error;return;}Error=null;await Load();}
    private async Task SimulateFailure(NotificationOutboxResponse n){var r=await Api.SendAsync<object>(HttpMethod.Post,$"api/notifications/outbox/{n.Id}/simulate-failure");if(!r.IsSuccess){Error=r.Error;return;}Error=null;await Load();}
    private async Task Retry(NotificationOutboxResponse n){var r=await Api.SendAsync<object>(HttpMethod.Post,$"api/notifications/outbox/{n.Id}/retry");if(!r.IsSuccess){Error=r.Error;return;}Error=null;await Load();}
    private static string StateName(string code)=>code switch{"PENDING"=>"Pendiente","SIMULATED_SENT"=>"Procesado internamente (simulado)","FAILED"=>"Fallido (simulado)",_=>code};
    private static string EventName(string code)=>code switch{"ORDER_RECEIVED"=>"Pedido recibido","ORDER_PREPARED"=>"Pedido preparado","OUT_FOR_DELIVERY"=>"Salió a reparto","DELIVERY_RESCHEDULED"=>"Entrega reprogramada","DELIVERY_COMPLETED"=>"Entrega realizada",_=>code};
}
