@page "/customers"
@inject ApiClient Api
@inject ApiSession Session
@inject NavigationManager Navigation

<PageTitle>Clientes | Sora</PageTitle>
<header class="page-heading"><div><span class="eyebrow">MAESTROS</span><h1>Clientes</h1><p>Fichas con dirección y coordenadas para organizar las entregas.</p></div>@if(Session.HasPermission("customers.write")){<button class="button primary" @onclick="OpenNew">+ Nuevo cliente</button>}</header>
<div class="directory-page">
    <section class="panel"><div class="panel-title"><h2>Directorio</h2><button class="button secondary" @onclick="Load">Actualizar</button></div>
        <CollectionBrowser TItem="CustomerResponse" Items="CustomerRows" Columns="CustomerColumns" Context="pageRows">
            <div class="table-scroll"><table><thead><tr><th>Cliente</th><th>Tipo</th><th>Teléfono</th><th>Dirección</th><th>Estado</th><th></th></tr></thead><tbody>
            @foreach (var item in pageRows) { <tr><td><strong>@item.FullName</strong></td><td>@TypeName(item.CustomerType)</td><td>@item.Phone</td><td>@item.PrimaryAddress</td><td>@(item.IsActive ? "Activo" : "Inactivo")</td><td class="row-actions">@if(Session.HasPermission("customers.write")){<button class="link-button" @onclick="() => Edit(item)">Editar</button>@if(item.IsActive){<button class="link-button danger-text" @onclick="() => Deactivate(item)">Desactivar</button>}else{<button class="link-button" @onclick="() => Activate(item)">Reactivar</button>}}</td></tr> }
            </tbody></table></div>
        </CollectionBrowser>
        @if (CustomerRows.Count == 0) { <p class="empty">Todavía no hay clientes registrados.</p> }
    </section>
    @if(Session.HasPermission("customers.write"))
    {
        <FormModal IsOpen="FormOpen" Title="@(EditingId is null ? "Nuevo cliente" : "Editar cliente")" OnClose="CloseForm">
            <EditForm Model="Form" OnValidSubmit="Save"><DataAnnotationsValidator />
                <label>Tipo</label><InputSelect class="form-select" @bind-Value="Form.CustomerType"><option value="STORE">Tienda</option><option value="FAMILY">Familia</option><option value="INSTITUTION">Institución</option></InputSelect>
                <label>Nombre / razón social</label><InputText class="form-control" @bind-Value="Form.FullName" />
                <label>Teléfono</label><InputText class="form-control" @bind-Value="Form.Phone" />
                <label>Dirección</label><InputText class="form-control" @bind-Value="Form.PrimaryAddress" />
                <div class="location-picker-field"><MapLocationPicker Latitude="Form.Latitude" Longitude="Form.Longitude" OnSelected="ApplyCoordinates" /><span class="muted">Selecciona el punto exacto de entrega en el mapa o introduce las coordenadas manualmente.</span></div>
                <div class="form-grid"><div><label>Latitud</label><InputNumber class="form-control" @bind-Value="Form.Latitude" /></div><div><label>Longitud</label><InputNumber class="form-control" @bind-Value="Form.Longitude" /></div></div>
                @if (Error is not null) { <div class="alert error">@Error</div> }
                <div class="actions"><button class="button primary">Guardar cliente</button><button type="button" class="button secondary" @onclick="Reset">Cancelar</button></div>
            </EditForm>
        </FormModal>
    }
</div>

@code {
    private static readonly CollectionColumn<CustomerResponse>[] CustomerColumns =
    [
        new("name", "Cliente", x => x.FullName, x => x.FullName),
        new("type", "Tipo", x => TypeName(x.CustomerType), x => TypeName(x.CustomerType)),
        new("phone", "Teléfono", x => x.Phone, x => x.Phone),
        new("address", "Dirección", x => x.PrimaryAddress, x => x.PrimaryAddress),
        new("status", "Estado", x => x.IsActive ? "Activo" : "Inactivo", x => x.IsActive ? "Activo" : "Inactivo")
    ];
    private List<CustomerResponse> CustomerRows = [];
    private SaveCustomerRequest Form { get; set; } = NewForm();
    private Guid? EditingId;
    private bool FormOpen;
    private string? Error, Notice;
    protected override async Task OnInitializedAsync() { if (!Session.IsSignedIn) { Navigation.NavigateTo("/login"); return; } if(!Session.CanAccessPage("customers")){Navigation.NavigateTo("/forbidden");return;} await Load(); }
    private async Task Load() { var r = await Api.SendAsync<List<CustomerResponse>>(HttpMethod.Get, "api/customers"); if (r.IsSuccess) CustomerRows = r.Value ?? []; else Error = r.Error; }
    private async Task Save() { var r = await Api.SendAsync<CustomerResponse>(EditingId is null ? HttpMethod.Post : HttpMethod.Put, EditingId is null ? "api/customers" : $"api/customers/{EditingId}", Form); if (!r.IsSuccess) { Error = r.Error ?? "No se pudo guardar."; return; } Notice = EditingId is null ? "Cliente registrado." : "Cliente actualizado."; Error = null; Reset(); await Load(); }
    private void OpenNew() { EditingId = null; Form = NewForm(); Error = null; FormOpen = true; }
    private void Edit(CustomerResponse c) { EditingId = c.Id; Form = new() { CustomerType=c.CustomerType, FullName=c.FullName, Phone=c.Phone, PrimaryAddress=c.PrimaryAddress, Latitude=c.Latitude, Longitude=c.Longitude }; Error = null; FormOpen = true; }
    private void ApplyCoordinates(MapCoordinates coordinates) { Form.Latitude = (decimal)coordinates.Latitude; Form.Longitude = (decimal)coordinates.Longitude; }
    private async Task Deactivate(CustomerResponse c) { var r = await Api.SendAsync<object>(HttpMethod.Delete, $"api/customers/{c.Id}"); if (r.IsSuccess) { Notice = "Cliente desactivado."; await Load(); } else Error = r.Error; }
    private async Task Activate(CustomerResponse c) { var r = await Api.SendAsync<object>(HttpMethod.Post, $"api/customers/{c.Id}/activate"); if (r.IsSuccess) { Notice = "Cliente reactivado."; await Load(); } else Error = r.Error; }
    private void Reset() { EditingId = null; Form = NewForm(); FormOpen = false; Error = null; }
    private void CloseForm() { FormOpen = false; Error = null; }
    private static SaveCustomerRequest NewForm() => new() { CustomerType="STORE" };
    private static string TypeName(string type) => type switch { "STORE" => "Tienda", "FAMILY" => "Familia", _ => "Institución" };
}
