@page "/inventory"
@inject ApiClient Api
@inject ApiSession Session
@inject NavigationManager Navigation
<PageTitle>Inventario | Sora</PageTitle>
<header class="page-heading"><div><span class="eyebrow">EXISTENCIAS</span><h1>Inventario</h1><p>Recepciona por lote y revisa unidades disponibles, reservadas y físicas.</p></div></header>
<div class="inventory-layout">
    <section class="panel"><h2>Registrar recepción</h2><EditForm Model="ReceiptForm" OnValidSubmit="Receive"><DataAnnotationsValidator/><ValidationSummary/>
        <label>Proveedor</label><InputSelect class="form-select" @bind-Value="SupplierIdText"><option value="">Selecciona proveedor</option>@foreach(var s in SupplierRows){<option value="@s.Id">@s.Name</option>}</InputSelect>
        <label>Factura</label><InputText class="form-control" @bind-Value="ReceiptForm.InvoiceNumber"/>
        @foreach(var (line,index) in ReceiptLines.Select((x,i)=>(x,i))){<div class="draft-lines"><h3>Producto y lote @(index+1)</h3>
            <label>Producto</label><InputSelect class="form-select" @bind-Value="line.ProductId"><option value="">Selecciona producto</option>@foreach(var p in ProductRows){<option value="@p.Id">@p.InternalCode · @p.Name</option>}</InputSelect>
            <div class="form-grid"><div><label>Lote</label><InputText class="form-control" @bind-Value="line.LotCode"/></div><div><label>Vencimiento</label><InputDate TValue="DateOnly?" class="form-control" @bind-Value="line.ExpiryDate"/></div></div>
            <div class="form-grid"><div><label>Unidades recibidas</label><InputNumber class="form-control" min="1" @bind-Value="line.Quantity"/></div><div><label>Costo por unidad (Bs)</label><InputNumber class="form-control" min="0" @bind-Value="line.UnitCost"/></div></div>
            @if(ReceiptLines.Count>1){<button type="button" class="link-button danger-link" @onclick="()=>ReceiptLines.RemoveAt(index)">Quitar línea</button>}
        </div>}
        <button type="button" class="button secondary" @onclick="AddReceiptLine">Añadir producto o lote</button>
        <button class="button primary full">Guardar recepción</button></EditForm>
        @if(Error is not null){<div class="alert error">@Error</div>} @if(Notice is not null){<div class="alert success">@Notice</div>}
        <a class="text-link" href="suppliers">Administrar proveedores →</a>
    </section>
    <section class="panel"><div class="panel-title"><div><h2>Stock por lote</h2><p class="muted">FEFO ordena primero los vencimientos más cercanos.</p></div><button class="button secondary" @onclick="LoadStock">Actualizar</button></div>
        <div class="table-scroll"><table><thead><tr><th>Producto</th><th>Lote / vence</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th>Costo/u</th><th>Ajuste</th></tr></thead><tbody>@foreach(var lot in Stock){<tr><td><strong>@lot.ProductName</strong><small class="block">@lot.ProductCode</small></td><td>@lot.LotCode<small class="block">@(lot.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Sin vencimiento")</small></td><td>@lot.OnHandUnits</td><td>@lot.ReservedUnits</td><td><span class="stock-count">@lot.AvailableUnits</span></td><td>Bs @lot.UnitPurchaseCost.ToString("0.00")</td><td><button class="link-button" @onclick="()=>AdjustLot=AdjustLot==lot.LotId?null:lot.LotId">Ajustar</button>
        @if(AdjustLot==lot.LotId){<div class="inline-adjust"><input type="number" class="form-control" @bind="Delta"/><input class="form-control" placeholder="Motivo" @bind="Reason"/><button class="button primary" @onclick="()=>Adjust(lot.LotId)">Aplicar</button></div>}</td></tr>}</tbody></table></div>
        @if(Stock.Count==0){<p class="empty">No hay lotes todavía. Registra una recepción para cargar existencias.</p>}
    </section>
</div>
@code {
    private List<SupplierResponse> SupplierRows=[];private List<ProductResponse> ProductRows=[];private List<InventoryStockLotResponse> Stock=[];
    private ReceiptEntryForm ReceiptForm {get;set;}=new();private string SupplierIdText="";private List<ReceiptLineForm> ReceiptLines=[new()];private int Delta;private string Reason="";private Guid? AdjustLot;private string? Error,Notice;
    protected override async Task OnInitializedAsync(){if(!Session.IsSignedIn){Navigation.NavigateTo("/login");return;}if(!Session.CanAccessPage("inventory")){Navigation.NavigateTo("/forbidden");return;}var s=await Api.SendAsync<List<SupplierResponse>>(HttpMethod.Get,"api/suppliers");if(s.IsSuccess)SupplierRows=(s.Value??[]).Where(x=>x.IsActive).ToList();var p=await Api.SendAsync<List<ProductResponse>>(HttpMethod.Get,"api/products");if(p.IsSuccess)ProductRows=(p.Value??[]).Where(x=>x.IsActive).ToList();await LoadStock();}
    private async Task LoadStock(){var r=await Api.SendAsync<List<InventoryStockLotResponse>>(HttpMethod.Get,"api/inventory/stock");if(r.IsSuccess)Stock=r.Value??[];else Error=r.Error;}
    private async Task Receive(){if(!Guid.TryParse(SupplierIdText,out var supplierId)||ReceiptLines.Count==0||ReceiptLines.Any(x=>!Guid.TryParse(x.ProductId,out _)||string.IsNullOrWhiteSpace(x.LotCode)||x.Quantity<=0||x.UnitCost<0)){Error="Completa el proveedor y todos los productos, lotes, cantidades y costos.";return;}var request=new CreatePurchaseReceiptRequest{SupplierId=supplierId,InvoiceNumber=ReceiptForm.InvoiceNumber,Lines=ReceiptLines.Select(x=>new PurchaseReceiptLineRequest{ProductId=Guid.Parse(x.ProductId),LotCode=x.LotCode,ExpiryDate=x.ExpiryDate,Quantity=x.Quantity,UnitPurchaseCost=x.UnitCost}).ToList()};var r=await Api.SendAsync<PurchaseReceiptResponse>(HttpMethod.Post,"api/inventory/receipts",request);if(!r.IsSuccess){Error=r.Error;return;}Notice=$"Recepción registrada: {r.Value?.LotCount} lotes, {r.Value?.TotalUnits} unidades.";Error=null;ReceiptForm=new();SupplierIdText="";ReceiptLines=[new()];await LoadStock();}
    private void AddReceiptLine()=>ReceiptLines.Add(new());
    private async Task Adjust(Guid id){var type=Delta<0?"LOSS":"ADJUSTMENT";var r=await Api.SendAsync<object>(HttpMethod.Post,"api/inventory/adjustments",new AdjustStockRequest{LotId=id,QuantityDelta=Delta,MovementType=type,Reason=Reason});if(!r.IsSuccess){Error=r.Error;return;}Notice="Ajuste registrado en el historial.";Error=null;AdjustLot=null;Delta=0;Reason="";await LoadStock();}
    private sealed class ReceiptEntryForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string InvoiceNumber { get; set; } = string.Empty;
    }
    private sealed class ReceiptLineForm{public string ProductId{get;set;}="";public string LotCode{get;set;}="";public DateOnly? ExpiryDate{get;set;}public int Quantity{get;set;}=1;public decimal UnitCost{get;set;}}
}
