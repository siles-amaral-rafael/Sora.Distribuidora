@page "/"
@inject ApiSession Session
@inject NavigationManager Navigation

<PageTitle>Resumen | Sora</PageTitle>
@if (Session.IsSignedIn)
{
    <section class="dashboard-heading">
        <div><span class="eyebrow">ESPACIO DE TRABAJO · @Session.WorkspaceLabel.ToUpperInvariant()</span>
            <h1>@Greeting</h1>
            <p>@Description</p></div>
        <span class="dashboard-role-mark" aria-hidden="true">@RoleInitial</span>
    </section>
    <section class="workflow-banner">
        <div><span class="workflow-overline">FLUJO PRINCIPAL</span><h2>@WorkflowTitle</h2><p>@WorkflowDescription</p></div>
        @if (!string.IsNullOrWhiteSpace(PrimaryHref)) { <a class="button primary" href="@PrimaryHref">@PrimaryAction <span aria-hidden="true">→</span></a> }
    </section>
    <section class="workspace-section">
        <div class="section-heading"><div><span class="eyebrow">ACCESOS</span><h2>Tu espacio de trabajo</h2></div><span class="access-count">@VisibleModuleCount módulos disponibles</span></div>
        <div class="workspace-cards">
            @if (Session.CanAccessPage("orders")) { <a class="workspace-card" href="orders"><span class="workspace-card-icon">▣</span><span class="workspace-card-kicker">VENTAS</span><h3>Pedidos</h3><p>Registra, revisa y continúa el flujo de pedidos.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("customers")) { <a class="workspace-card" href="customers"><span class="workspace-card-icon">◎</span><span class="workspace-card-kicker">DIRECTORIO</span><h3>Clientes</h3><p>Consulta fichas, contactos y datos de entrega.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("products")) { <a class="workspace-card" href="products"><span class="workspace-card-icon">▦</span><span class="workspace-card-kicker">CATÁLOGO</span><h3>Productos</h3><p>Consulta artículos, precios y presentaciones.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("inventory")) { <a class="workspace-card" href="inventory"><span class="workspace-card-icon">▤</span><span class="workspace-card-kicker">EXISTENCIAS</span><h3>Inventario</h3><p>Controla lotes, vencimientos, reservas y ajustes.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("suppliers")) { <a class="workspace-card" href="suppliers"><span class="workspace-card-icon">⇄</span><span class="workspace-card-kicker">ABASTECIMIENTO</span><h3>Proveedores</h3><p>Administra proveedores y productos asociados.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("dispatches")) { <a class="workspace-card" href="dispatches"><span class="workspace-card-icon">➜</span><span class="workspace-card-kicker">DISTRIBUCIÓN</span><h3>Despachos</h3><p>Consulta salidas, asignaciones y resultados de entrega.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
            @if (Session.CanAccessPage("staff")) { <a class="workspace-card" href="staff"><span class="workspace-card-icon">♙</span><span class="workspace-card-kicker">ADMINISTRACIÓN</span><h3>Personal y roles</h3><p>Gestiona cuentas, roles y permisos de acceso.</p><span class="card-link">Abrir módulo <b>→</b></span></a> }
        </div>
    </section>
}

@code {
    private string Greeting => Session.WorkspaceProfile switch
    {
        "admin" => "Panel de administración",
        "seller" => "Panel de ventas",
        "warehouse" => "Operación de almacén",
        "dispatch-lead" => "Centro de despacho",
        "dispatch-assistant" => "Apoyo de despacho",
        "driver" => "Panel de reparto",
        _ => "Bienvenido a Sora"
    };
    private string Description => Session.WorkspaceProfile switch
    {
        "admin" => "Revisa y administra las áreas habilitadas para tu cuenta.",
        "seller" => "Atiende clientes y gestiona pedidos desde un flujo claro.",
        "warehouse" => "Controla existencias y prepara los pedidos pendientes.",
        "dispatch-lead" => "Organiza las salidas y registra los resultados de entrega.",
        "dispatch-assistant" => "Consulta el trabajo de despacho y registra resultados asignados.",
        "driver" => "Accede a la información de tus entregas y registra su resultado.",
        _ => "Accede a las funciones habilitadas para tu cuenta."
    };
    private string WorkflowTitle => Session.WorkspaceProfile switch
    {
        "admin" => "Vista general de la operación",
        "seller" => "Atención y registro de pedidos",
        "warehouse" => "Recepción, stock y preparación",
        "dispatch-lead" => "Salidas y control de entregas",
        "dispatch-assistant" => "Apoyo a las entregas",
        "driver" => "Seguimiento de entregas",
        _ => "Operación diaria"
    };
    private string WorkflowDescription => Session.WorkspaceProfile switch
    {
        "admin" => "Los accesos y acciones disponibles se determinan por los permisos de tu cuenta.",
        "seller" => "Busca al cliente, añade los productos y revisa disponibilidad antes de confirmar.",
        "warehouse" => "Registra ingresos por lote y continúa con los pedidos listos para preparación.",
        "dispatch-lead" => "Revisa la cola de pedidos y coordina las salidas con sus responsables.",
        "dispatch-assistant" => "Usa la vista de despachos para consultar y actualizar el trabajo asignado.",
        "driver" => "Consulta la salida correspondiente y deja constancia del resultado de cada visita.",
        _ => "Selecciona un módulo habilitado para continuar."
    };
    private string PrimaryHref => Session.WorkspaceProfile switch
    {
        "admin" when Session.CanAccessPage("staff") => "staff",
        "seller" when Session.CanAccessPage("orders") => "orders",
        "warehouse" when Session.CanAccessPage("inventory") => "inventory",
        "dispatch-lead" or "dispatch-assistant" or "driver" when Session.CanAccessPage("dispatches") => "dispatches",
        _ when Session.CanAccessPage("orders") => "orders",
        _ when Session.CanAccessPage("inventory") => "inventory",
        _ when Session.CanAccessPage("dispatches") => "dispatches",
        _ => ""
    };
    private string PrimaryAction => Session.WorkspaceProfile switch
    {
        "admin" => "Gestionar accesos",
        "seller" => "Ir a pedidos",
        "warehouse" => "Abrir inventario",
        "dispatch-lead" => "Abrir despachos",
        "dispatch-assistant" or "driver" => "Ver entregas",
        _ => "Continuar"
    };
    private string RoleInitial => Session.WorkspaceLabel[..1];
    private int VisibleModuleCount => new[] { "customers", "products", "suppliers", "inventory", "orders", "dispatches", "staff" }.Count(Session.CanAccessPage);

    protected override void OnInitialized()
    {
        if (!Session.IsSignedIn) Navigation.NavigateTo("/login");
    }
}
